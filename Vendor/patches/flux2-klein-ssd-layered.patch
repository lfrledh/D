+      try withUnsafeBytes(of: &huge) { Data($0) }.write(to: url)
+      XCTAssertThrowsError(try SafeTensorsReader(fileURL: url))
+      var truncated = UInt64(100).littleEndian
+      try withUnsafeBytes(of: &truncated) { Data($0) }.write(to: url)
+      XCTAssertThrowsError(try SafeTensorsReader(fileURL: url))
