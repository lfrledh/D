+                        inode: UInt64(value.st_ino), modifiedSeconds: value.st_mtimespec.tv_sec,
+                        modifiedNanoseconds: value.st_mtimespec.tv_nsec,
+                        changedSeconds: value.st_ctimespec.tv_sec,
+                        changedNanoseconds: value.st_ctimespec.tv_nsec)
+    }
