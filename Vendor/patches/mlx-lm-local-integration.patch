+    private static func descriptorIdentity(_ handle: FileHandle) throws -> Identity {
+        var value = stat()
+        guard fstat(handle.fileDescriptor, &value) == 0,
+              value.st_mode & S_IFMT == S_IFREG, value.st_size >= 0 else {
